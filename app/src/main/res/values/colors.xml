    <color name="shazam_dark_gray">#FF404040</color>
    <color name="shazam_medium_gray">#FF606060</color>
    <color name="shazam_light_gray">#FFAAAAAA</color>
    <color name="shazam_blue">#FF1E88E5</color>
    <color name="green">#FF4CAF50</color>
