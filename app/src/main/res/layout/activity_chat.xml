<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@drawable/shazam_background"
android:padding="16dp">

<!-- Шапка с информацией о враче -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/headerCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentTop="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/shazam_dark_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Кнопка назад -->
        <LinearLayout
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Информация о враче -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp">

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="👨‍⚕️"
                android:textSize="24sp"
                android:background="@drawable/circle_background"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/doctorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Доктор Иванов"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/doctorSpecialty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Терапевт"
                    android:textColor="@color/shazam_light_gray"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/connectionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● онлайн"
                    android:textColor="#4CAF50"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Кнопка видео звонка -->
        <LinearLayout
            android:id="@+id/videoCallButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📹"
                android:textSize="20sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<!-- ScrollView для чата -->
<ScrollView
    android:id="@+id/chatScrollView"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_below="@id/headerCard"
    android:layout_above="@+id/messageInputLayout"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="16dp"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <!-- Контейнер для чата -->
    <LinearLayout
        android:id="@+id/chatContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp" />

</ScrollView>

<!-- Панель ввода сообщения -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/messageInputLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/shazam_dark_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <!-- Кнопка прикрепления файла -->
        <LinearLayout
            android:id="@+id/attachButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📎"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- Поле ввода сообщения -->
        <EditText
            android:id="@+id/messageEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Введите сообщение..."
            android:textColor="@color/white"
            android:textColorHint="@color/shazam_light_gray"
            android:textSize="14sp"
            android:maxLines="3"
            android:padding="12dp" />

        <!-- Кнопка отправки -->
        <LinearLayout
            android:id="@+id/sendButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="@drawable/circle_background_blue"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="➤"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

<!-- Уведомление о наборе текста -->
<TextView
    android:id="@+id/typingIndicator"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_above="@id/messageInputLayout"
    android:layout_alignParentStart="true"
    android:layout_marginStart="16dp"
    android:layout_marginBottom="8dp"
    android:text="Доктор печатает..."
    android:textColor="@color/shazam_light_gray"
    android:textSize="12sp"
    android:visibility="gone" />

</RelativeLayout>