<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shazam_background"
    android:fillViewport="true"
    android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

                <!-- Заголовок -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="40dp"
                    android:text="Регистрация"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <!-- Контейнер для полей ввода -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                        <!-- Фамилия -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxBackgroundColor="@color/shazam_dark_gray"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:hintTextColor="@color/shazam_light_gray"
                            app:boxStrokeColor="@color/shazam_medium_gray">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etLastName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Фамилия"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:padding="16dp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Имя -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxBackgroundColor="@color/shazam_dark_gray"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:hintTextColor="@color/shazam_light_gray"
                            app:boxStrokeColor="@color/shazam_medium_gray">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etFirstName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Имя"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:padding="16dp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Логин -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxBackgroundColor="@color/shazam_dark_gray"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:hintTextColor="@color/shazam_light_gray"
                            app:boxStrokeColor="@color/shazam_medium_gray">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etUsername"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Логин"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:padding="16dp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Номер телефона -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxBackgroundColor="@color/shazam_dark_gray"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:hintTextColor="@color/shazam_light_gray"
                            app:boxStrokeColor="@color/shazam_medium_gray">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPhone"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Номер телефона"
                                    android:inputType="phone"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:padding="16dp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Пароль -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxBackgroundColor="@color/shazam_dark_gray"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:hintTextColor="@color/shazam_light_gray"
                            app:boxStrokeColor="@color/shazam_medium_gray"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/shazam_light_gray">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPassword"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Пароль"
                                    android:inputType="textPassword"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:padding="16dp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Подтвердить пароль -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="40dp"
                            app:boxBackgroundColor="@color/shazam_dark_gray"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:hintTextColor="@color/shazam_light_gray"
                            app:boxStrokeColor="@color/shazam_medium_gray"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/shazam_light_gray">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etConfirmPassword"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Подтвердить пароль"
                                    android:inputType="textPassword"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:padding="16dp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Кнопка регистрации -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegister"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginBottom="20dp"
                            android:backgroundTint="@color/shazam_dark_gray"
                            android:text="Зарегистрироваться"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="28dp" />

                        <ProgressBar
                            android:id="@+id/progressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:layout_marginBottom="20dp" />

                        <!-- Ссылка на вход -->
                        <TextView
                            android:id="@+id/tvLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Уже есть аккаунт? Войти"
                            android:textColor="@color/shazam_light_gray"
                            android:textSize="14sp"
                            android:padding="8dp" />

                </LinearLayout>

        </LinearLayout>

</ScrollView>