<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shazam_background"
    android:padding="24dp">

    <!-- Заголовок приложения с меню -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="30dp">

        <!-- Кнопка назад -->
        <LinearLayout
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/menu_button_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Назад"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Заголовок приложения -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOS Помощь"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Прозрачный элемент для баланса -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <!-- Заголовок страницы -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/headerLayout"
        android:layout_centerHorizontal="true"
        android:text="Оформить заявление"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.02" />

    <!-- Подзаголовок -->
    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/titleText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="Опишите вашу проблему"
        android:textColor="@color/shazam_light_gray"
        android:textSize="16sp" />

    <!-- Поле для заявления -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statementCard"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_below="@+id/subtitleText"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/shazam_dark_gray">

        <EditText
            android:id="@+id/statementEditText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="top"
            android:hint="Опишите подробно, что произошло, где и когда..."
            android:padding="16dp"
            android:textColor="@color/white"
            android:textColorHint="@color/shazam_light_gray"
            android:textSize="14sp"
            android:inputType="textMultiLine"
            android:maxLines="8"
            android:scrollbars="vertical" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Счетчик символов -->
    <TextView
        android:id="@+id/charCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/statementCard"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:text="0/1000"
        android:textColor="@color/shazam_light_gray"
        android:textSize="12sp" />

    <!-- Чекбокс подтверждения -->
    <LinearLayout
        android:id="@+id/checkboxLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/charCountText"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/menu_button_background"
        android:clickable="true"
        android:focusable="true">

        <CheckBox
            android:id="@+id/agreementCheckbox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:buttonTint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Принимаю всю ответственность за отправленное заявление"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Предупреждение о ложном вызове -->
    <TextView
        android:id="@+id/warningText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/checkboxLayout"
        android:layout_marginTop="16dp"
        android:background="@drawable/shazam_warning_background"
        android:gravity="center"
        android:padding="16dp"
        android:text="Помните, что ложный вызов грозит наказанием"
        android:textColor="@color/shazam_light_gray"
        android:textSize="14sp"
        android:textStyle="italic" />

    <!-- Кнопка отправки -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/sendButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/shazam_dark_gray"
        android:text="Отправить заявление"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp" />

</RelativeLayout>